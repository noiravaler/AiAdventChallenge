# Скопируйте файл в .env и заполните значения.
# .env добавлен в .gitignore — ключ не попадёт в репозиторий.

AI_API_KEY=sk-ваш-ключ
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_MODELS=gpt-4o-mini,gpt-4o,gpt-4-turbo   # список моделей для выпадающего списка (фолбэк)

# Необязательные настройки:
# AI_SYSTEM=Ты полезный ассистент. Отвечай кратко и по делу.
# AI_TIMEOUT=5m
# AI_MAX_TOKENS=0    # 0 → 15000

# Резервный провайдер [reserve] — используется, когда основной endpoint недоступен.
# AI_RESERVE_BASE_URL=https://api.deepseek.com/v1
# AI_RESERVE_API_KEY=sk-ваш-резервный-ключ
# AI_RESERVE_MODEL=deepseek-flash

# Флагманская модель (обслуживается резервным провайдером).
# AI_FLAGSHIP_MODEL=deepseek-v4-pro

# Маленькая модель (GPT-5 Nano): по умолчанию baseURL/apiKey берутся из конфига
# OpenCode (~/.config/opencode/opencode.json). Явные AI_SMALL_* перекрывают конфиг.
# AI_SMALL_BASE_URL=https://polza.ai/api/v1
# AI_SMALL_API_KEY=sk-ваш-ключ
# AI_SMALL_MODEL=gpt-5-nano
# OPENCODE_CONFIG=~/.config/opencode/opencode.json
