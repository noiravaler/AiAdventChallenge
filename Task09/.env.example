# Скопируйте файл в .env и заполните значения.
# .env добавлен в .gitignore — ключ не попадёт в репозиторий.

AI_API_KEY=sk-ваш-ключ
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_MODELS=gpt-4o-mini,gpt-4o,gpt-4-turbo   # список моделей для бокового меню (фолбэк)

# Необязательные настройки:
# AI_SYSTEM=Ты полезный ассистент. Отвечай кратко и по делу.
# AI_TIMEOUT=5m
# AI_MAX_TOKENS=0

# Резервный провайдер [reserve] — используется, когда основной endpoint недоступен.
# AI_RESERVE_BASE_URL=https://api.deepseek.com/v1
# AI_RESERVE_API_KEY=sk-ваш-резервный-ключ
# AI_RESERVE_MODEL=deepseek-flash

# Сохранение контекста веб-чата между перезапусками (путь к файлу истории).
# AI_HISTORY_FILE=history/.chat-history.json
