# Скопируйте файл в .env и заполните значения.
# .env добавлен в .gitignore — ключ не попадёт в репозиторий.

AI_API_KEY=sk-ваш-ключ
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# AI_MODELS=gpt-4o-mini,gpt-4o,gpt-4-turbo   # список моделей для бокового меню (фолбэк)

# Необязательные настройки:
# AI_SYSTEM — системный промпт; в Task19 закрепляет правила предсказуемости цепочек:
#   при ошибке/пустом результате не звать следующий шаг, назвать шаг и причину,
#   не выдавать результат, которого нет (см. README, раздел «Цепочки инструментов orbit»).
# AI_SYSTEM=Ты ассистент с инструментами, включая цепочки orbit (elect_*, brief_*). Если инструмент вернул ошибку или пустой результат — не вызывай следующий шаг цепочки: остановись и сообщи, на каком шаге цепочка остановилась и почему. Не выдавай результат, которого нет: используй только фактические данные из результатов инструментов. Ошибку можно один раз повторить тем же шагом; при повторном сбое остановись и объясни причину.
# AI_TIMEOUT=5m
# AI_MAX_TOKENS=0

# Резервный провайдер [reserve] — используется, когда основной endpoint недоступен.
# AI_RESERVE_BASE_URL=https://api.deepseek.com/v1
# AI_RESERVE_API_KEY=sk-ваш-резервный-ключ
# AI_RESERVE_MODEL=deepseek-flash

# Удалённые MCP-серверы (Streamable HTTP): slug=URL через запятую.
# Пусто = список по умолчанию (Dubai Grocery Prices, локальный Orbit); "off" = выключить.
# AI_MCP_URLS=dubai=https://prices.brainy.ae/mcp,orbit=http://127.0.0.1:5199/mcp
# Таймаут одного вызова MCP-инструмента (по умолчанию 30s).
# AI_MCP_TIMEOUT=30s

# Планировщик фоновых задач: горутина внутри приложения.
# Задачи выполняются только пока приложение запущено; пропущенные запуски не навёрстываются.
# AI_SCHEDULER=1
# База SQLite планировщика (задачи + журнал запусков).
# AI_SCHEDULER_DB=scheduler.db
